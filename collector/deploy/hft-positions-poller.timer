[Unit]
Description=Опрос позиций операторов HL раз в час

[Timer]
# OnCalendar, а НЕ OnBootSec + OnUnitActiveSec: после рестарта таймера у той
# пары не остаётся точки отсчёта (`Trigger: n/a`), и 23 часа ряда были потеряны
# молча — измерено 12.08 на params-поллере, том же классе таймера.
OnCalendar=hourly

# Шестьдесят адресов по одному REST-запросу: разводим их с круглым часом и с
# каталожным опросом params-поллера, который бьёт с задержкой до 180 с.
RandomizedDelaySec=240

# Догонять НУЖНО: окно `userFunding` у площадки конечно, пропущенный час
# укатывается за его край и не восстанавливается ничем.
Persistent=true

[Install]
WantedBy=timers.target
