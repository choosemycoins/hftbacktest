# Инстанс захвата дня-0. Ставится как /opt/hft-collector/etc/binancefuturesum-day0.env
#
# ⚠ ЭТОТ ФАЙЛ ПЕРЕПИСЫВАЕТСЯ ЦЕЛИКОМ поллером day0_poller на каждой волне листингов.
# Правки руками живут ровно до следующего листинга. Менять надо константы в
# collector/tools/day0_poller.py (ENV_PATH, STALL_TIMEOUT_MIN, LIVENESS_TIMEOUT_S).
#
# ⚠ ПОРЯДОК ВКЛЮЧЕНИЯ. COLLECTOR_SYMBOLS здесь ПУСТ намеренно: символы появятся с
# первой волной поллера. Пока список пуст, инстанс включать НЕЛЬЗЯ —
# collector-run.sh выходит с кодом 4 («COLLECTOR_SYMBOLS is empty»), Restart=always
# крутит юнит в цикле и выжигает StartLimitBurst, а OnFailure шлёт алерты. Порядок:
#   1) systemctl enable --now hft-day0-poller.timer
#   2) дождаться первого тика: непустой список ниже + pulse-*.gz в /home/ubuntu/day0-data
#   3) systemctl enable --now hft-collector@binancefuturesum-day0
#
COLLECTOR_EXCHANGE=binancefuturesum

# Заполняется поллером: символы дословно из exchangeInfo, через пробел, в порядке
# (onboardDate, symbol). Коллектор binancefuturesum символы НЕ валидирует вообще
# (fetch_symbol_list определена, но не вызывается), поэтому опечатка была бы
# абсолютно молчаливой — отсюда требование писать имена дословно, а не конструировать.
COLLECTOR_SYMBOLS=

RUST_LOG=info

# 1080 мин / 64800 с — не оговорка, а условие работоспособности этого инстанса.
# Две причины, обе измерены:
#   1) подписка на ещё НЕ ТОРГУЮЩИЙСЯ символ площадкой принимается, но не даёт ни
#      одного кадра (WS-проба на GAIBUSDT: три стрима подтверждены, 0 кадров за 12 с,
#      контроль BTCUSDT — 2334 кадра). Дефолтный сторож тишины 5 мин убивал шестёрку
#      каждые 305 с: 10 падений за 45 минут, ровно StartLimitBurst;
#   2) сессионные TRADIFI-эквити (34 из 36 листингов за 30 суток; KR/HK/CN/US)
#      легитимно молчат вне сессии биржи-источника — всю ночь.
# 1080 минут (18 ч) кроет оба случая с запасом.
COLLECTOR_STALL_TIMEOUT_MIN=1080
COLLECTOR_LIVENESS_TIMEOUT_S=64800
