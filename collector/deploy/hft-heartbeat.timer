[Unit]
Description=Heartbeat по коллекторам и поллерам (тишина = тревога)

[Timer]
# Каждые 30 минут: это ВЕРХНЯЯ граница задержки обнаружения тишины. Порог свежести
# у коллекторов 10 минут, значит мёртвый источник заметен максимум через 40.
# Сообщение при этом уходит НЕ каждые 30 минут: тревога рейт-лимитится (по умолчанию
# раз в час), а «всё норм» отправляется один раз в сутки в HEARTBEAT_DIGEST_HOUR.
OnCalendar=*:00/30
# Не в ноль минут ровно: там же ротация файлов и суточный гейт.
RandomizedDelaySec=90
# ⚠️ НЕ ставить Persistent=true: догонять пропущенные проверки бессмысленно —
# «было ли свежо три часа назад» нас не интересует, интересует «свежо ли сейчас».
Persistent=false

[Install]
WantedBy=timers.target
