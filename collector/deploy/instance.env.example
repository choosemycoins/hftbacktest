# Per-instance configuration for hft-collector@<instance>.service.
#
# Copy to /opt/hft-collector/etc/<instance>.env, one file per collection job.
# The instance name is the file's basename:
#
#   cp instance.env.example /opt/hft-collector/etc/bybit.env
#   $EDITOR /opt/hft-collector/etc/bybit.env
#   sudo systemctl enable --now hft-collector@bybit
#
# This file is sourced by systemd's EnvironmentFile, NOT by a shell. That
# means: no command substitution, no variable expansion, no inline comments
# after a value. Quotes around a value are stripped by systemd.

# Which venue to record. One of:
#   binancefutures | binancefuturesum   USD-M perpetual futures
#   binancefuturescm                    COIN-M futures
#   binance | binancespot               spot
#   bybit                               linear perpetuals (V5)
#   hyperliquid                         perpetuals
# The stream/topic set per venue is fixed in collector/src/main.rs.
COLLECTOR_EXCHANGE=hyperliquid

# Whitespace-separated symbols, in the venue's own notation, passed through
# verbatim — case matters. Output filenames are always lowercased regardless.
#
# Hyperliquid perps have NO quote suffix: `BTC`, not `BTCUSDT`. The quote shown
# in the web UI is the dex's collateral token, not part of the instrument name.
#
# HIP-3 builder dexes each have their own universe and their own collateral,
# and their names carry a `dex:` prefix which IS the wire name — `hyna:ENA`
# (USDE-collateralised) is a different instrument from the canonical `ENA`
# (USDC), with a separate book. `GOLD` exists ONLY on builder dexes, so one has
# to be chosen deliberately; `xyz:GOLD` is USDC-collateralised.
#
# Every name is verified against the venue at startup and the collector refuses
# to run on an unknown one — on Hyperliquid a single bad coin closes the whole
# WebSocket and takes the valid subscriptions down with it.
#
# Bybit example:   COLLECTOR_SYMBOLS=BTCUSDT ETHUSDT
# Binance topics are lowercase: btcusdt
COLLECTOR_SYMBOLS=SUI SEI TIA INJ JTO PENDLE ENA ONDO HYPE xyz:GOLD

# Where the .gz files land. One file per symbol per UTC day:
#   ${COLLECTOR_DATA_DIR}/<symbol-lowercase>_<YYYYMMDD>.gz
#
# This grows without bound and is never pruned by the collector — budget disk
# and add your own retention. If you point this outside
# /opt/hft-collector/data you MUST also widen ReadWritePaths in a unit
# drop-in, or the service will fail to write under ProtectSystem=strict.
COLLECTOR_DATA_DIR=/opt/hft-collector/data/hyperliquid

# Log verbosity (tracing EnvFilter syntax). `info` gives connect/disconnect,
# date rotation and startup provenance. `debug` is very noisy at tick rates.
RUST_LOG=info

# ---------------------------------------------------------------- optional
# Everything below is optional. Leave a line out and the binary's own default
# applies — the wrapper omits the flag entirely rather than restating it.

# Stop and exit non-zero when free space on COLLECTOR_DATA_DIR's filesystem
# falls below this. Checked at startup and every minute. Default 5, `0`
# disables. Budget from the measured rates: a Hyperliquid major is ~22 MB/day,
# a Bybit linear pair with depths 1,50 is ~86 MB/day — several times that in a
# volatile session.
#COLLECTOR_MIN_FREE_GB=5

# Bybit only. Orderbook depths to subscribe to. A single rejected topic fails
# the whole batch, and `500` is rejected for the majors despite being
# documented. Default 1,50; 200 is a safe widening for BTCUSDT/ETHUSDT/SOLUSDT.
#COLLECTOR_BYBIT_DEPTHS=1,50

# Hyperliquid only. Which l2Book cadences to record. `slow` = 20 levels/~5.4s,
# `fast` = 5 levels/~0.54s, `none` = no book. Default records both, so that
# different merge policies can be compared over the same recording later.
#COLLECTOR_HL_L2_MODES=slow,fast

# Set to 1 to skip the startup check that every symbol exists on the venue.
# Only do this if the venue's symbol list endpoint is unreachable — on
# Hyperliquid an unknown coin closes the whole WebSocket and the collector
# then records partial data indefinitely while appearing healthy.
#COLLECTOR_NO_SYMBOL_CHECK=0
