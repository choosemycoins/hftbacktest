# Daily snapshot of the Lighter-on-Robinhood-Chain points leaderboard and the
# per-account volume table (public, unauthenticated GETs; see the docstring of
# tools/lighter_rh_points.py). Driven by hft-lighter-rh-points.timer.
#
# Writes /opt/hft-collector/data/lighter-rh-points/points_<YYYYMMDD>.gz, which
# offload.sh moves off the host like any day file. Exit 1 = nothing written
# (venue refused or changed shape) and fires the alert unit; exit 3 = written
# but the volume walk fell short of `total`, also alerted so a drifting
# population is noticed.
[Unit]
Description=Lighter-RH points snapshot (public leaderboard + volume table)
Documentation=file:///opt/hft-collector/current/tools/lighter_rh_points.py
After=network-online.target
Wants=network-online.target
OnFailure=hft-collector-alert@%n.service
RequiresMountsFor=/opt/hft-collector/data

[Service]
Type=oneshot
User=hftcollector
Group=hftcollector
WorkingDirectory=/opt/hft-collector
ExecStartPre=/usr/bin/mkdir -p /opt/hft-collector/data/lighter-rh-points
ExecStart=/usr/bin/python3 -I /opt/hft-collector/current/tools/lighter_rh_points.py --out-dir /opt/hft-collector/data/lighter-rh-points
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=1200
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/hft-collector/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hft-lighter-rh-points
