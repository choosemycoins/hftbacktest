# Инстанс сбора USDC-перпов Binance USDⓈ-M. Ставится как
# /opt/hft-collector/etc/binancefuturesum-usdc.env
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ИНСТАНС, А НЕ ДОСЫПАТЬ СИМВОЛЫ В СУЩЕСТВУЮЩИЙ
#
# 1. Книги этих символов НЕТ НИГДЕ ПУБЛИЧНО. data.binance.vision не публикует
#    bookTicker для USDⓈ-M вообще: у BTCUSDC/ETHUSDC ровно 87 суточных архивов
#    2024-01…2024-04, а у всего, что листнуто позже (BIOUSDC, WLFIUSDC,
#    PENGUUSDC, ZECUSDC…), директория пуста. bookDepth есть, но это ±0.2/1/2/3/5 %
#    раз в минуту — не тач. То есть этот инстанс — единственный прибор.
# 2. Гейт отчитывается по-инстансно, и этому нужен СВОЙ профиль (GATE_PROFILE
#    ниже): потеря стакана здесь обязана быть красной.
# 3. binancefuturesum-day0 переписывается поллером листингов целиком, дописывать
#    туда что-либо руками бессмысленно.
COLLECTOR_EXCHANGE=binancefuturesum

# ОТБОР. Правило одно, применено ко всем 38 USDC-перпам (exchangeInfo,
# 2026-08-27, статус TRADING):
#
#   пишем символ ⟺ (1) решётка СВОБОДНА — доля времени со спредом шире одного
#                      тика ≥ 0.60, взвешенная по биржевому времени;
#                  (2) полуспред ≥ 1.20 бп — верх измеренного пола маркаута
#                      (−0.6…−1.2 бп при комиссии мейкера 0).
#
# Прибор: 10.9 ч собственной записи книги (2026-08-27 00:00–10:55 UTC, 33
# символа) плюс 40-минутная проба для пяти символов, которых в той записи не
# было. Порог 0.60 лежит в САМОМ БОЛЬШОМ разрыве рейтинга ширины (NEO 0.627 →
# SUI 0.477); прежняя редакция отбора ставила его на 0.50 и попадала в место,
# где соседние значения отличаются на 5 пп, то есть внутри шума окна.
#
# Что делает каждое условие:
#   (1) отсекает символы с ЗАПЕРТОЙ решёткой (медиана = 1 тик). Для них вердикт
#       уже есть: смещение оценщика мида по ленте калибровалось ИМЕННО на
#       запертых решётках (все калибровочные монеты USDT — 1 тик), поэтому туда
#       оно переносится напрямую, и mo с поправкой садится на −0.58…−0.78 —
#       ровно закон. Наша книга там не добавляет знания, только байты.
#   (2) отсекает символы, где ответ арифметический: потолок захвата ниже пола
#       сноса, и никакая книга знак не поменяет (BTCUSDC 0.006 бп, ETHUSDC
#       0.020, SOLUSDC 0.494 — это не «мало», это на два порядка мимо).
#
# ZECUSDC — ЕДИНСТВЕННОЕ ИСКЛЮЧЕНИЕ, и оно названо: полуспред 0.510 бп, то есть
# по правилу (2) он вылетает. Он остаётся как ЯКОРЬ КАЛИБРОВКИ: это
# единственный символ класса, у которого решётка свободна (8 тиков) И лента
# плотная (137 тыс. принтов/сут, то есть выше суррогатного гейта 30 тыс.).
# Только на нём можно проверить оценщик мида по ленте против НАСТОЯЩЕЙ книги
# НА USDC, а не переносить проверку с USDT. Без него §7.4 отчёта остаётся
# открытым навсегда. Он не кандидат в деньги и в этом качестве не считается.
#
# NEOUSDT — не USDC-символ и не опечатка. NEOUSDC (5 212 принтов/сут) —
# единственный отобранный символ, у которого НЕРАЗРЕШИМЫ ОБЕ стороны пары:
# у двойника NEOUSDT 15 276 принтов, тоже ниже гейта. Без собственной книги по
# двойнику парный контраст «свободная решётка против запертой» по этому символу
# не считается вообще ничем. Остальным 23 парам хватает нашей USDC-стороны:
# у них USDT-двойник плотный, и его лента вердикт несёт.
#
# Порядок: алфавитный, USDT-двойник в конце. Имена ДОСЛОВНО из exchangeInfo —
# коллектор binancefuturesum символы НЕ валидирует (fetch_symbol_list
# определена и не вызывается), площадка опечатку принимает, акает и молча не
# отдаёт ничего. Ловит её только отсутствие файла, COLLECTOR_LIVENESS_TIMEOUT_S
# и утренний гейт.
COLLECTOR_SYMBOLS=1000BONKUSDC 1000SHIBUSDC AAVEUSDC ARBUSDC AVAXUSDC BCHUSDC BIOUSDC BOMEUSDC CRVUSDC DATAIPUSDC ENAUSDC ETHFIUSDC FILUSDC HBARUSDC KAITOUSDC NEOUSDC ORDIUSDC PENGUUSDC PNUTUSDC TIAUSDC UNIUSDC WLDUSDC WLFIUSDC ZECUSDC NEOUSDT

RUST_LOG=info

# Профиль ночного гейта ДЛЯ ЭТОГО ИНСТАНСА. Читается gate-run.sh из этого файла
# (без исполнения файла); сам коллектор переменную не читает.
#
# book-v1 требует все три потока Binance — bookTicker, trade И depthUpdate.
# Под дефолтным mode-a-v1 стакан «опционален», потеря его даёт ЖЁЛТЫЙ, а таймер
# эскалирует только КРАСНЫЙ: инстанс, который пишут ради книги, потерял бы книгу
# молча и узнали бы мы об этом при сборке датасета.
GATE_PROFILE=book-v1

# Сторож тишины per-symbol. 300 с — дефолт этой площадки, и он здесь ПРОВЕРЕН:
# самый тонкий символ набора (DATAIPUSDC) даёт 0.76 венью-кадра в секунду, то
# есть до порога ему далеко. Гейдж считает только кадры БИРЖИ (Source::Venue),
# поэтому десятисекундный поллер premiumIndex его не сбрасывает и мёртвый сокет
# им не замаскируется.
#COLLECTOR_LIVENESS_TIMEOUT_S=300

# Полное молчание = фатал. Дефолт 5 минут годится: набор из 24 символов, где
# самый тихий печатает 0.76 кадра/с, не может замолчать целиком иначе как из-за
# нас или площадки.
#COLLECTOR_STALL_TIMEOUT_MIN=5

# COLLECTOR_DATA_DIR НЕ ЗАДАВАТЬ. Дефолт /opt/hft-collector/data/<instance> —
# единственный путь, гарантированно попадающий в ReadWritePaths юнита.
