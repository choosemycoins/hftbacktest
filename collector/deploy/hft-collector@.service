[Unit]
# Templated unit: one instance per collection job, named after its env file.
#   systemctl enable --now hft-collector@bybit
# reads /opt/hft-collector/etc/bybit.env and records what that file describes.
#
# One instance per exchange is the intended granularity. The collector binary
# takes a single exchange and one symbol list per process, so a second venue
# means a second instance, not a second argument.
Description=hftbacktest market-data collector (%i)
Documentation=file:///opt/hft-collector/current/README.md
After=network-online.target
Wants=network-online.target

# Every failure alerts (Telegram via deploy/alert.sh). Wired UNCONDITIONALLY:
# on a host without /opt/hft-collector/etc/alert.env the hook logs "alert not
# sent" and exits 0, so an unconfigured deployment loses nothing — and a
# configured one cannot forget to wire it. Credentials are operator-authored,
# never in git: see deploy/alert.env.example. %n passes the FULL failed unit
# name, which is what alert.sh expects and rate-limits on.
OnFailure=hft-collector-alert@%n.service

# Every recorded line is stamped with Utc::now() and the output file is chosen
# by UTC date, so starting before the clock is disciplined can misdate a file
# and, worse, cause a spurious rotation when the clock steps.
After=time-sync.target
Wants=time-sync.target

# Refuse to start unless the data directory's mount is up.
#
# Without this, a volume that has not mounted yet is silently catastrophic
# rather than merely inconvenient: collector-run.sh would mkdir the data
# directory on the ROOT filesystem, the statvfs free-space check would measure
# the root filesystem and pass, recording would proceed — and the moment the
# volume does mount, everything written so far disappears underneath it.
#
# Pair this with `nofail` in /etc/fstab. The host then still boots and stays
# reachable when the volume is missing, but the collector declines to record
# into the wrong place. If COLLECTOR_DATA_DIR points somewhere else, change
# this path to match via a drop-in.
RequiresMountsFor=/opt/hft-collector/data

# The start rate limiter belongs to the Unit, not the Service. Placed under
# [Service] these are silently ignored (StartLimitIntervalSec is not a
# [Service] key at all), leaving a crash-looping instance unthrottled.
#
# The interval has to be long relative to the SLOWEST way the collector exits,
# not the fastest, or the failure it was added for is the one that never
# surfaces. The stall watchdog (--stall-timeout-min, default 5) exits at
# t+300s, RestartSec adds 5s, so a permanently silent-but-connected feed
# restarts every ~305s. At the previous interval of 300s that is at most one
# start per window, StartLimitBurst=10 is never reached, and the unit
# oscillates between activating and active for ever — never `failed`, so
# OnFailure below never fires and nothing alerts. Meanwhile a hard network
# outage exits in ~1s, restarts every ~6s and reaches the limit in a minute,
# which is why the loop is easy to miss when testing.
#
# ⚠️ That last clause was the bug, and it cost the only recording this project
# has ever lost outright. On 2026-08-09 Lighter answered /api/v1/orderBooks
# with 503 for about two minutes. The collector refuses to start without a
# catalog — correctly, it is fail-closed — so it exited in under a second,
# eleven times in 118 seconds, which burned StartLimitBurst=10 and left the
# unit `failed`. The next systemd line for it is `Started` 43.6 hours later,
# by hand. Twenty-three markets, ~880 MB, unrecoverable: Lighter serves no
# historical replay of its stream, so those frames exist nowhere.
#
# The reasoning above was sound for the slow exit and simply did not cover the
# fast one. A transient venue outage — the single most likely thing to happen
# to a market-data collector — must not be able to reach a terminal state at
# all, so the limiter is off and the restart is backed off instead:
#
#   * RestartSec/RestartSteps/RestartMaxDelaySec grow the delay 5s -> 300s over
#     ten restarts (~18 minutes for those ten, against ~1 minute before), so a
#     crash-looping build cannot spin the CPU or fill the journal, which is the
#     one thing StartLimitBurst was actually protecting.
#   * StartLimitIntervalSec=0 removes the terminal state. A venue that is down
#     for a day is retried for a day; there is nothing a human could do to it
#     that the retry does not already do.
#
# What that gives up is the alarm: with no `failed` state, OnFailure= above
# never fires for a crash loop. That is deliberate, and only defensible because
# the alarm has moved somewhere strictly better — `heartbeat.sh` (timer at :00
# and :30) enumerates every instance in etc/*.env and reports one with no .gz
# newer than COLLECTOR_STALE_MIN=10 minutes. It watches the OUTCOME, files on
# disk, rather than the process state, so it also catches the case this unit
# never could: a collector that is running, connected and recording nothing.
# Removing that timer without replacing this alarm re-opens the 43-hour hole.
#
# RestartSteps and RestartMaxDelaySec need systemd >= 254 (host: 259).
StartLimitIntervalSec=0

[Service]
Type=simple

User=hftcollector
Group=hftcollector
WorkingDirectory=/opt/hft-collector

# Versioned-release layout: `current` is a symlink that install.sh swaps
# atomically and rollback.sh flips back. Pointing ExecStart through the
# symlink is what makes a rollback a symlink flip plus a restart.
Environment=COLLECTOR_HOME=/opt/hft-collector/current
Environment=COLLECTOR_INSTANCE=%i
Environment=RUST_LOG=info

# Per-instance settings: COLLECTOR_EXCHANGE and COLLECTOR_SYMBOLS, plus the
# optional COLLECTOR_DATA_DIR (default /opt/hft-collector/data/%i — one
# directory per instance, which is required: the collector locks it and a
# second instance sharing it would not start). See instance.env.example. The
# unit refuses to start if this file is missing rather than silently recording
# nothing.
EnvironmentFile=/opt/hft-collector/etc/%i.env

ExecStart=/opt/hft-collector/current/bin/collector-run.sh

# A collector that dies mid-day leaves a gap in the recording, so restart
# eagerly. `always` rather than `on-failure` because a clean exit still means
# recording has stopped. The backoff ladder (5s -> 300s over ten restarts) is
# what stops a crash-looping build from spinning the CPU and filling the
# journal — see the note in [Unit] above for why it, rather than a start-rate
# limit, is the thing doing that job now.
#
# `systemctl stop` is unaffected by Restart=always — systemd does not restart
# a unit it stopped itself — so the SIGTERM path stays clean.
Restart=always
RestartSec=5s
RestartSteps=10
RestartMaxDelaySec=300s

# SIGTERM is what makes the gzip stream valid. The collector handles it
# explicitly (see shutdown_signal in collector/src/main.rs), flushes every
# open RotatingFile through GzEncoder::finish, and exits 0. TimeoutStopSec
# must stay generous enough for that flush; a SIGKILL here truncates the
# current gzip member.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

# Resource hygiene. One WebSocket per venue plus one file handle per symbol
# is modest, but symbol lists grow.
LimitNOFILE=65535

# The recorded data is the only thing this service owns that matters.
# ReadWritePaths must cover COLLECTOR_DATA_DIR from the instance env file;
# if you point that outside /opt/hft-collector/data (e.g. a mounted volume),
# add it here via a drop-in:
#   systemctl edit hft-collector@bybit
#   [Service]
#   ReadWritePaths=/mnt/marketdata
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/hft-collector/data

# Remote alerting hangs off unit failure (OnFailure= in [Unit] above), because
# that is what the collector is built to produce: it exits non-zero on a disk
# floor breach, an unknown symbol, or a write error, rather than degrading
# quietly. The delivery mechanism IS shipped now — deploy/alert.sh +
# hft-collector-alert@.service — only the credentials stay site-specific
# (deploy/alert.env.example describes them, including the dead-man heartbeat
# URL the daily gate pings).
#
# The other half is the sidecar: plain text, flushed per record, carrying a
# `{"_collector":"disk","free_bytes":…}` line every minute. Ship it with the
# journal, or scrape it, and you have free-space history per instance without
# a metrics agent.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hft-collector-%i

[Install]
WantedBy=multi-user.target
