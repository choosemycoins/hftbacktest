[Unit]
Description=Опрос параметров площадок раз в час

[Timer]
# OnCalendar, а НЕ OnBootSec + OnUnitActiveSec. Измерено 12.08 на этой самой
# паре: после рестарта таймера не остаётся точки отсчёта (`Trigger: n/a`), и
# 23 часа ряда были потеряны молча.
OnCalendar=hourly

# Параметры меняются деплоями, а не поминутно, так что джиттер можно позволить
# большой: он разводит нас с чужими каталожными опросами в круглый час.
RandomizedDelaySec=180

# Догонять НУЖНО, в отличие от фандинга: пропущенный час — это дыра в ряду
# изменений, а сам ряд разрежённый, и восстановить его задним числом неоткуда
# (каталоги площадок отдают только «сейчас»).
Persistent=true

[Install]
WantedBy=timers.target
