# hft-collector@lighter-rh — Lighter on Robinhood Chain (api.rh.lighter.xyz).
#
# Install as /opt/hft-collector/etc/lighter-rh.env. Format rules are those of
# instance.env.example: systemd EnvironmentFile, no expansion, no inline
# comments after a value.
#
# Why this instance exists. The RH instance charges maker = taker = 0 on all 85
# markets (Standard tier) and runs its own points programme (since 2026-08-10,
# a pool of 11M LIT, weekly drop on Fridays). The question this recording has
# to answer is the maker's net there: spread capture minus adverse selection at
# zero fee, per symbol. The points side is measured separately by
# collector/tools/lighter_rh_points.py.
#
# `lighter-rh` is its own backend name, not `lighter` with an endpoint
# override: the two instances share symbol names (BTC is market 1 on both), so
# an override that silently failed to apply would record mainnet into this
# directory with nothing wrong in the files. The name fixes the endpoints in
# code and stamps them into session_start (`lighter_endpoints`).
COLLECTOR_EXCHANGE=lighter-rh

# 22 perps, 88 subscriptions of the 100 a connection may spend (MAX_MARKETS =
# 25). Chosen from /api/v1/orderBookDetails, 2026-10-08 ~09:45 UTC, instance
# 24h volume $716.6M:
#
#   * the top 14 by 24h quote volume, $632M = 88% of the instance:
#     BTC 140.2  SPY 113.1  QQQ 80.6  XAU 64.1  ETH 58.4  ANTHROPIC 36.7
#     NVDA 25.8  OPENAI 22.4  AAPL 20.8  SNDK 17.9  SOL 14.6  GOOGL 13.4
#     XAG 13.0  HYPE 11.1  ($M). This is where points are earned by volume,
#     and where the cross-instance comparison with the core Lighter recording
#     (NVDA GOOGL AAPL SNDK ANTHROPIC OPENAI XAG are recorded there too) is
#     cleanest;
#   * 8 thinner ones, because on core Lighter the maker edge lived in thin
#     symbols (population +3.56 bp ex-HYPE vs +0.07 bp on HYPE, 2026-08-14):
#     SPCX 6.1 (lockup/IPO calendar), LIT 5.1 (the reward token itself),
#     CRCL 3.7 (26k prints/day - many small fills), PONS 1.95, CASHCAT 0.82,
#     TSM 0.81, SOXL 0.69, USELESS 0.13. PONS CASHCAT SOXL SPCX are also on the
#     core recording.
#
# Spot pairs (`SPY/USDG` ...) are NOT recordable by this collector: a `/` in
# the symbol cannot be a filename and the backend refuses it at startup. All 27
# spot pairs together traded $4.2M of the $716.6M (SPY/USDG $3.45M of it), so
# nothing is lost for the maker question.
#
# Three slots are left free on purpose: they are the margin against the
# message budget, which this collector spends per connection while the venue
# does not say whether its 200/min is per connection or per IP.
#
# Volume, measured 2026-10-08 09:55-10:04 UTC (9.5 min local run, this exact
# set, US cash market closed): 7.9 MB gzip / 65.6 MB raw -> ~1.2 GB/day gzip
# (~10 GB/day raw). Largest: BTC ~113, ETH ~97, SPY ~89 MB/day; smallest SPCX,
# AAPL ~22-23. Budget 2 GB/day for US hours, when the stock perps trade more.
# Zero sequence gaps, per-symbol liveness max age 1 s throughout.
#
# The set is pinned by `the_deployed_rh_symbol_set_resolves_against_the_rh_catalog`
# in collector/src/lighter/mod.rs: every name must resolve, as an active perp,
# against the catalog captured on 2026-10-08.
COLLECTOR_SYMBOLS=BTC SPY QQQ XAU ETH ANTHROPIC NVDA OPENAI AAPL SNDK SOL GOOGL XAG HYPE SPCX LIT CRCL PONS CASHCAT TSM SOXL USELESS

RUST_LOG=info

# Per-symbol liveness: left at the binary's default for an unmeasured venue
# (300 s). The core instance gets 60 s from a market_stats cadence measured
# there; on RH the stock perps have not been measured off US hours, so the
# tighter number is not borrowed.
#COLLECTOR_LIVENESS_TIMEOUT_S=300
