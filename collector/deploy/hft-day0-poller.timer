[Unit]
Description=Тик поллера листингов дня-0 раз в 10 минут

[Timer]
# OnCalendar, а НЕ OnBootSec + OnUnitActiveSec. Измерено 12.08 на params-poller: после
# РЕСТАРТА таймера у той пары не остаётся точки отсчёта (`Trigger: n/a`), поллер
# отработал один раз и не встал — 23 часа ряда потеряно молча. OnCalendar от рестартов
# не зависит.
OnCalendar=*:00/10

# Не бить в круглую минуту вместе со всем миром. Вес запроса — 1 при бюджете 2400/мин,
# то есть дело не в лимите, а в том, чтобы не ловить чужой всплеск на происхождении.
RandomizedDelaySec=60

# Persistent=false, и это осознанное отступление от DESIGN §11 (там было true).
# Догонять тут нечего: каденция 10 минут, и после простоя хоста ближайший штатный тик
# наступит в пределах тех же 10 минут. Догоняющий запуск дал бы выигрыш ≤10 минут,
# зато ровно на буте — когда сеть ещё поднимается, а промах читался бы как провал
# и накручивал бы счётчик. Волну это не теряет: детектор основан на СОСТОЯНИИ, а не
# на моменте наблюдения, поэтому пропущенный тик ничего не пропускает — символ,
# появившийся во время простоя, будет новым ключом на первом же живом тике.
Persistent=false

[Install]
WantedBy=timers.target
