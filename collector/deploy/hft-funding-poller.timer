[Unit]
Description=Тик поллера кросс-венью фандинга раз в 5 минут

[Timer]
# OnCalendar, а НЕ OnBootSec + OnUnitActiveSec. Измерено 12.08 на params-poller:
# после рестарта таймера у той пары не остаётся точки отсчёта (`Trigger: n/a`),
# 23 часа ряда потеряно молча. OnCalendar от рестартов не зависит.
OnCalendar=*:0/5

# Не бить в круглую минуту вместе со всем миром. Задержка МАЛЕНЬКАЯ намеренно:
# порог сторожа 20 мин = 3 пропущенных тика + запас, большой джиттер съедал бы
# запас.
RandomizedDelaySec=30

# Догонять нечего: каденция 5 минут, после простоя ближайший штатный тик наступит
# в пределах тех же 5 минут, а догоняющий запуск на буте (сеть ещё поднимается)
# читался бы как провал и накручивал бы счётчики ног.
Persistent=false

[Install]
WantedBy=timers.target
