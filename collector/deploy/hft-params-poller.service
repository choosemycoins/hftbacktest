[Unit]
# Ряд администрируемых параметров площадок: тик, минимальный ноутионал, тиры
# маржи, максимальное плечо, статус рынка, комиссии, интервал фандинга. Всё это
# назначается деплоем или голосованием, а не торгуется, и каждое изменение —
# датированное событие с известным направлением воздействия. Ряда этих изменений
# не ведёт никто, потому что это считается сантехникой.
Description=Поллер администрируемых параметров площадок (тик, лот, маржа, статус) — ряд изменений, которого не ведёт никто
Documentation=file:/opt/hft-collector/current/bin/params_poller.py

# Сеть нужна, и Wants= здесь не декорация: без него юнит не ПОДТЯГИВАЕТ цель, а
# только упорядочивается за ней, и догоняющий запуск на буте уходит в сеть,
# которой ещё нет. У прежней, ручной редакции этого юнита было только After=.
After=network-online.target
Wants=network-online.target

# Никакого терминального состояния у сетевого поллера: транзиентный отказ
# площадки не должен превращаться в мёртвый юнит. Та же причина, что у
# hft-collector@.service, где этот механизм уже стоил нам 43 часов записи.
StartLimitIntervalSec=0

# Провал должен быть слышен. У прежней редакции OnFailure не было вовсе, и
# упавший поллер молчал: единственным сигналом оставалась тишина в heartbeat
# через полтора часа.
OnFailure=hft-collector-alert@%n.service

# Откат на релиз, который поллера ещё не знал, обязан быть тихим пропуском, а не
# штормом тревог: без этого каждый тик после отката поднимал бы alert.
ConditionPathExists=/opt/hft-collector/current/bin/params_poller.py

[Service]
Type=oneshot

# Выход — на ТОМ ЖЕ томе, что и вся остальная лента, и это главная правка.
# Прежняя редакция писала в /home/ubuntu/params-data, то есть на КОРНЕВОЙ диск
# (6.7 ГБ, свободно 3.4), мимо вывоза и мимо гейта: замерено 2026-08-22 — 24 МБ
# истории параметров существовали ровно в одном экземпляре и не были вывезены
# ни разу. На /opt/hft-collector/data их подхватывает offload.sh наравне с
# каталогом funding.
#
# Журнал остаётся в /home/ubuntu/params-data — ровно как у funding-поллера,
# который логирует в свой pulse-каталог: сторож смотрит на ДАННЫЕ, а не на лог.
ExecStart=/usr/bin/python3 /opt/hft-collector/current/bin/params_poller.py /opt/hft-collector/data/params --once
StandardOutput=append:/home/ubuntu/params-data/poller.log
StandardError=append:/home/ubuntu/params-data/poller.log

# Две вКПУ, и единственная работа этой коробки — не отставать от ленты.
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
